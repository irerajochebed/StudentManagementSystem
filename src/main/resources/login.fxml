<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studentms.ui.controller.LoginController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #1a237e;">

   <!-- Header -->
   <VBox alignment="CENTER" style="-fx-background-color: #1a237e;" spacing="6">
      <padding><Insets top="50" bottom="30" /></padding>
      <Label text="🎓 Student Management System" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
      <Label text="Please sign in to continue" style="-fx-text-fill: #90caf9; -fx-font-size: 13px;" />
   </VBox>

   <!-- Login Card -->
   <VBox alignment="CENTER" spacing="14" maxWidth="380"
         style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 4);">
      <padding><Insets top="35" bottom="35" left="40" right="40" /></padding>

      <Label text="Sign In" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

      <!-- Username -->
      <VBox spacing="4">
         <Label text="Username" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <TextField fx:id="usernameField" promptText="Enter username" styleClass="login-field" />
      </VBox>

      <!-- Password -->
      <VBox spacing="4">
         <Label text="Password" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="login-field" />
      </VBox>

      <!-- Error message -->
      <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="300"
             style="-fx-text-fill: #e53935; -fx-font-size: 12px;" />

      <!-- Login Button -->
      <Button fx:id="loginBtn" text="Sign In" onAction="#handleLogin"
              maxWidth="Infinity" styleClass="btn-primary" />

      <Separator />

      <!-- Register link -->
      <HBox alignment="CENTER" spacing="6">
         <Label text="Don't have an account?" style="-fx-text-fill: #777; -fx-font-size: 12px;" />
         <Button text="Register" onAction="#goToRegister" styleClass="btn-link" />
      </HBox>

      <!-- Hint -->
      <VBox alignment="CENTER" spacing="2"
            style="-fx-background-color: #e8f5e9; -fx-background-radius: 6; -fx-padding: 8;">
         <Label text="Default Accounts:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" />
         <Label text="admin / admin123  |  instructor / teach123  |  student / student123"
                style="-fx-font-size: 10px; -fx-text-fill: #388e3c;" />
      </VBox>
   </VBox>

   <VBox.margin>
      <Insets bottom="50" />
   </VBox.margin>
</VBox>
