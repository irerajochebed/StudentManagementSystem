<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studentms.ui.controller.RegisterController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #1a237e;">

   <!-- Header -->
   <VBox alignment="CENTER" style="-fx-background-color: #1a237e;" spacing="6">
      <padding><Insets top="40" bottom="25" /></padding>
      <Label text="🎓 Student Management System" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
      <Label text="Create a new account" style="-fx-text-fill: #90caf9; -fx-font-size: 13px;" />
   </VBox>

   <!-- Register Card -->
   <VBox alignment="CENTER" spacing="12" maxWidth="380"
         style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 4);">
      <padding><Insets top="30" bottom="30" left="40" right="40" /></padding>

      <Label text="Register" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

      <!-- Full Name -->
      <VBox spacing="4">
         <Label text="Full Name" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <TextField fx:id="fullNameField" promptText="e.g. Jane Smith" styleClass="login-field" />
      </VBox>

      <!-- Username -->
      <VBox spacing="4">
         <Label text="Username" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <TextField fx:id="usernameField" promptText="Choose a username" styleClass="login-field" />
      </VBox>

      <!-- Password -->
      <VBox spacing="4">
         <Label text="Password (min 6 chars)" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <PasswordField fx:id="passwordField" promptText="Choose a password" styleClass="login-field" />
      </VBox>

      <!-- Role -->
      <VBox spacing="4">
         <Label text="Role" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <ComboBox fx:id="roleCombo" maxWidth="Infinity" styleClass="login-field" />
      </VBox>

      <!-- Linked ID -->
      <VBox spacing="4">
         <Label text="Your Student/Instructor ID (leave blank for Admin)" style="-fx-font-size: 12px; -fx-text-fill: #555;" />
         <TextField fx:id="linkedIdField" promptText="e.g. STU-001 or INS-001" styleClass="login-field" />
      </VBox>

      <!-- Error / Success message -->
      <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="300"
             style="-fx-font-size: 12px;" />

      <!-- Register Button -->
      <Button text="Create Account" onAction="#handleRegister"
              maxWidth="Infinity" styleClass="btn-primary" />

      <Separator />

      <!-- Back to login -->
      <HBox alignment="CENTER" spacing="6">
         <Label text="Already have an account?" style="-fx-text-fill: #777; -fx-font-size: 12px;" />
         <Button text="Sign In" onAction="#goToLogin" styleClass="btn-link" />
      </HBox>
   </VBox>

   <VBox.margin>
      <Insets bottom="40" />
   </VBox.margin>
</VBox>
